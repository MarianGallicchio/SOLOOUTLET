# ── Base de datos MySQL/MariaDB ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TU_CONTRASEÑA_MYSQL
DB_NAME=solooutlet

# ── Seguridad ──
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
PORT=3001

# ── URLs ──
# FRONT_URL: origen del frontend (para CORS y back_urls de Mercado Pago).
FRONT_URL=http://localhost:5173

# ── Google Sign-In (opcional: habilita "Continuar con Google") ──
# Client ID de https://console.cloud.google.com/apis/credentials (tipo "ID de cliente OAuth" · App web)
# Orígenes autorizados: http://localhost:3000 y tu dominio de producción.
GOOGLE_CLIENT_ID=

# ── Mercado Pago (INFORMACIÓN SENSIBLE: no subir a GitHub) ──
# Access Token de TU cuenta: https://www.mercadopago.com.ar/developers/panel/app
# Producción: APP_USR-...   ·  Pruebas (sandbox): TEST-...
MP_ACCESS_TOKEN=

# ── Frontend (Vite) ──
# Mismo Client ID de Google, para renderizar el botón "Continuar con Google".
VITE_GOOGLE_CLIENT_ID=
# Apunta al backend para activar el modo API (MySQL + pagos reales).
VITE_API_URL=http://localhost:3001
