# ── SoloOutlet · configuración ──────────────────────────────
# GEMINI_API_KEY: solo si usás funciones de IA (hoy no se usa).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_URL: URL de tu backend (cuando subas la base de datos).
# Vacío = modo demo con localStorage. Ejemplo:
# VITE_API_URL="https://api.solooutlet.com"
VITE_API_URL=""

# Mercado Pago (cuando actives cobros reales):
# VITE_MP_PUBLIC_KEY="APP-xxx"
# MP_ACCESS_TOKEN="APP_USR-xxx"  (solo en el servidor, NUNCA en el front)

# Emails del staff con acceso al Panel Admin global:
# VITE_PLATFORM_OWNERS="admin@solooutlet.com"
